# Compose-level variables (copy to .env). NEVER commit the real file.
POSTGRES_PASSWORD=CHANGE_ME
NODE_ENV=production
APP_ENV=production            # development | staging | production. production refuses dev secrets and DEMO seeding
PORT=4000
JWT_ACCESS_SECRET=CHANGE_ME_64_RANDOM_CHARS_MIN_32
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=7
WEB_ORIGIN=http://localhost:8080
PUBLIC_BASE_URL=http://localhost:8080
MAP_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png   # DEV ONLY — choose a licensed provider for production
MAP_ATTRIBUTION=© OpenStreetMap contributors
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
SMS_PROVIDER=
EMAIL_PROVIDER=
