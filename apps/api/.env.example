# ── KODEMS API ── copy to .env; never commit real secrets
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://kodems:CHANGE_ME@localhost:5432/kodems
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=CHANGE_ME_LONG_RANDOM_64
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=7
WEB_ORIGIN=http://localhost:3000
# Object storage (S3-compatible). Leave blank to use local ./uploads in development ONLY.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Providers: leave blank = reported as NOT_CONFIGURED, nothing is "sent".
SMS_PROVIDER=
SMS_API_KEY=
EMAIL_PROVIDER=
EMAIL_API_KEY=
# Demo data is NEVER seeded automatically; run `npm run db:seed:demo` in non-production only.
APP_ENV=development

# Per-process PostgreSQL pool limit. Budget replicas x this value against DB max_connections.
DB_POOL_MAX=10
