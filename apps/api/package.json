{
  "name": "@kodems/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm run db:generate && nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "npm run db:generate && tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test --ext .ts",
    "test": "jest --runInBand --forceExit",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "ts-node prisma/seed.ts",
    "db:seed:demo": "node scripts/seed-demo.js",
    "boundaries:import": "ts-node scripts/import-boundaries.ts",
    "db:generate": "prisma generate",
    "db:sql": "node scripts/gen-sql.js",
    "db:erd": "node scripts/gen-erd.js",
    "docs:api": "node scripts/gen-api-docs.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.0.0",
    "@nestjs/websockets": "^11.0.0",
    "@nestjs/throttler": "^6.0.0",
    "argon2": "^0.41.0",
    "bullmq": "^5.0.0",
    "cookie-parser": "^1.4.6",
    "exceljs": "^4.4.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "otplib": "^12.0.1",
    "pdfkit": "^0.15.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "socket.io": "^4.8.0",
    "zod": "^3.23.0",
    "@prisma/client": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.13.4",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0",
    "prisma": "^7.10.1",
    "@prisma/internals": "^7.10.1",
    "@types/pg": "^8.11.0"
  }
}
